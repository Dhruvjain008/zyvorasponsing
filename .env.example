# ── Environment Variables ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values for local development.
# NEVER commit the actual .env file to git.

# Required: a long random secret for Flask sessions
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: Giphy API key for GIF picker
GIPHY_API_KEY=

# Optional: override DB directory (default: db/ folder in project root)
# On Render this is set to /var/data automatically via render.yaml
# DB_DIR=/var/data

# Optional: override host/port for local dev
# HOST=127.0.0.1
# PORT=5000
